# ── App Configuration ─────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to 'true' to force-reset the 'admin' user password to 'Admin@12345' on boot
FORCE_ADMIN_RESET=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./secureeye.db

# ── Email Alerts (SMTP) ───────────────────────────────────────────────────────
# NOTE: For Gmail, you MUST use an "App Password" (16 characters), not your regular password.
# Enable 2FA -> Security -> App Passwords in your Google account settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_FROM_EMAIL=your-email@gmail.com

# ── Chat Integration Webhooks (Optional) ──────────────────────────────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
NTFY_TOPIC=

# ── Threat Feed Polling ──────────────────────────────────────────────────────
FEED_POLL_INTERVAL_MINUTES=30
WARM_START_FEEDS_ENABLED=false
KEEP_ALIVE_INTERVAL_SECONDS=240
PUBLIC_BACKEND_URL=
CRITICAL_CVSS_THRESHOLD=8.5

# ── AI Tiered Summarization Engine ────────────────────────────────────────────
# The AI summarizer uses a tiered chain: Gemini (Tier 1) -> Hugging Face (Tier 2) -> Groq (Tier 3) -> Rule Engine Fallback
# Get a free Google Gemini key at: https://aistudio.google.com/
GEMINI_API_KEY=
# Get a free Hugging Face API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Get a free Groq API key at: https://console.groq.com/
GROQ_API_KEY=

# ── IOC Enrichment & Sandbox Engine ───────────────────────────────────────────
# 1. VirusTotal API Key (Tier 1 Hash & IP Lookup)
# Get a free key (4 req/min, 500/day) at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# 2. AbuseIPDB API Key (Free tier IP check, 1000/day)
# Get a free key at: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# 3. AlienVault OTX API Key (Free IP/domain/hash reputation check)
# Get a free key at: https://otx.alienvault.com/
ALIENVAULT_OTX_API_KEY=

# 4. Hybrid Analysis API Key (Sandbox lookup)
# Get a free key at: https://www.hybrid-analysis.com/api/v2
HYBRID_ANALYSIS_API_KEY=

# Completely Free Fallback Services (Integrated automatically with NO API KEYS needed):
# - Shodan InternetDB (Free ports, vulnerabilities, and hostnames lookup)
# - GreyNoise Community (Free IP classifications and background noise checks)
# - URLhaus API (Free lookup for malicious URLs, domains, and files)
# - MalwareBazaar API (Free malware sample hash lookup and signature search)

# ── Web Search & OSINT Aggregator ─────────────────────────────────────────────
# Search Provider can be 'brave', 'google', or 'threat_intel' (DuckDuckGo fallback is automatic)
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_RESULTS_LIMIT=10

# For Brave Search, get a free-tier key (or paid) at: https://search.brave.com/api
BRAVE_API_KEY=

# For Google Search, get keys at:
# 1. API Key: https://developers.google.com/custom-search/v1/overview
# 2. Engine ID: https://cse.google.com/cse/all
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── External Threat Intelligence (Optional) ──────────────────────────────────
# Get a free NVD API key to bypass rate limits: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Get a free ThreatFox API key for active malware IOC feeds: https://threatfox.abuse.ch/api/
THREATFOX_AUTH_KEY=

# ── Dark Web Breach Monitoring ───────────────────────────────────────────────
# The engine uses: HIBP Passwords (no key) + EmailRep.io (no key) -> Breach Directory (RapidAPI)
# Get a Breach Directory key if you want to use the legacy RapidAPI provider: https://rapidapi.com/
BREACH_DIRECTORY_API_KEY=

# Leak-Lookup API Key (Free tier available for public API)
# Get a free API key at: https://leak-lookup.com
LEAK_LOOKUP_API_KEY=
