# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-secret-random-string-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./secureeye.db

# PostgreSQL (production recommended)
# DATABASE_URL=postgresql://secureeye:yourpassword@localhost:5432/secureeye

# ── Email Alerts (SMTP) ───────────────────────────────────────────────────────
# Leave blank to disable email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=secureeye@wipro.com

# ── Slack Alerts ──────────────────────────────────────────────────────────────
# Paste your incoming webhook URL here, or leave blank to disable
SLACK_WEBHOOK_URL=

# ── MS Teams Alerts ───────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=

# ── Feed Settings ─────────────────────────────────────────────────────────────
FEED_POLL_INTERVAL_MINUTES=30
CRITICAL_CVSS_THRESHOLD=8.5

# ── AI Summarization (Optional) ───────────────────────────────────────────────
# Provide an OpenAI key to enable AI-generated advisory summaries
OPENAI_API_KEY=

# ── Web Search (Optional) ─────────────────────────────────────────────────────
# Default uses Brave web search without an API key.
# Supported values: brave, google, threat_intel
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_RESULTS_LIMIT=10
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
