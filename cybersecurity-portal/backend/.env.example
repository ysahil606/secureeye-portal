# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-long-random-string-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./secureeye.db

# ── Email Alerts (SMTP) ───────────────────────────────────────────────────────
# NOTE: For Gmail, you MUST use an "App Password" (16 characters), not your regular password.
# Enable 2FA -> Security -> App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_FROM_EMAIL=your-email@gmail.com

# ── Slack Alerts ──────────────────────────────────────────────────────────────
# Create an "Incoming Webhook" in Slack settings.
SLACK_WEBHOOK_URL=

# ── MS Teams Alerts ───────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=

# ── Feed Settings ─────────────────────────────────────────────────────────────
FEED_POLL_INTERVAL_MINUTES=30
WARM_START_FEEDS_ENABLED=false
KEEP_ALIVE_INTERVAL_SECONDS=240
PUBLIC_BACKEND_URL=
CRITICAL_CVSS_THRESHOLD=8.5

# ── AI Summarization (Gemini) ─────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ── Web Search ────────────────────────────────────────────────────────────────
# Provider can be 'brave', 'google', or 'threat_intel'
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_RESULTS_LIMIT=10

# For Google Search, get keys at: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── External Intel Keys (Optional) ────────────────────────────────────────────
# Get a free NVD key to avoid rate limiting: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Get a free ThreatFox key: https://threatfox.abuse.ch/api/
THREATFOX_AUTH_KEY=

# Hybrid Analysis (Malware Sandbox) Key: https://www.hybrid-analysis.com/api/v2
HYBRID_ANALYSIS_API_KEY=
